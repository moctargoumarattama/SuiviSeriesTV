@model RegisterViewModel
@{
    ViewData["Title"] = "Inscription";
}

<div class="auth-shell">
    <div class="auth-card card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <h1 class="h3 mb-2">Creer un compte</h1>
            <p class="text-muted mb-4">Inscription simple avec email et mot de passe.</p>

            <form asp-action="Register" method="post" class="row g-3">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="col-12">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control form-control-lg" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control form-control-lg" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control form-control-lg" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div class="col-12 d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">S'inscrire</button>
                </div>
            </form>

            <p class="mt-4 mb-0 text-muted">
                Deja inscrit ?
                <a asp-action="Login">Connexion</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

