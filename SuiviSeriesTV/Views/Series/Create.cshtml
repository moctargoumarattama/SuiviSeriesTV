@model Serie
@{
    ViewData["Title"] = "Ajouter un contenu";
}

<section class="hero-strip rounded-4 p-4 p-md-5 mb-4 reveal premium-panel create-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <p class="ops-kicker mb-2">CONTENT STUDIO</p>
            <h1 class="h2 mb-2">Ajouter un contenu</h1>
            <p class="text-muted mb-0">Creez une fiche claire, complete et prete pour votre suivi premium.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="TmdbSearch" class="btn btn-primary">
                <i class="bi bi-cloud-download me-1"></i> Importer TMDB
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Retour
            </a>
        </div>
    </div>
</section>

<div class="row g-4 create-shell">
    <div class="col-xl-8">
        <section class="card border-0 shadow-sm reveal premium-panel create-form-panel">
            <div class="card-body p-3 p-md-4">
                <form asp-action="Create" method="post" enctype="multipart/form-data" class="row g-3">
                    <input type="hidden" asp-for="TmdbId" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-12 create-section-title">Infos principales</div>

                    <div class="col-md-3">
                        <label asp-for="ContentType" class="form-label"></label>
                        <select asp-for="ContentType" asp-items="Html.GetEnumSelectList<ContentType>()" class="form-select"></select>
                    </div>
                    <div class="col-md-5">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Genre" class="form-label"></label>
                        <input asp-for="Genre" class="form-control" />
                        <span asp-validation-for="Genre" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-12 create-section-title">Progression et statut</div>

                    <div class="col-md-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" asp-items="Html.GetEnumSelectList<SerieStatus>()" class="form-select"></select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="SeasonsCount" class="form-label"></label>
                        <input asp-for="SeasonsCount" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="TotalEpisodes" class="form-label"></label>
                        <input asp-for="TotalEpisodes" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="WatchedEpisodes" class="form-label"></label>
                        <input asp-for="WatchedEpisodes" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="LastWatchedSeason" class="form-label"></label>
                        <input asp-for="LastWatchedSeason" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="LastWatchedEpisode" class="form-label"></label>
                        <input asp-for="LastWatchedEpisode" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="PersonalRating" class="form-label"></label>
                        <input asp-for="PersonalRating" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="AverageEpisodeRuntimeMinutes" class="form-label"></label>
                        <input asp-for="AverageEpisodeRuntimeMinutes" class="form-control" />
                    </div>

                    <div class="col-12 create-section-title">Plateforme et dates</div>

                    <div class="col-md-4">
                        <label asp-for="StreamingPlatform" class="form-label"></label>
                        <input asp-for="StreamingPlatform" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DateAdded" class="form-label"></label>
                        <input asp-for="DateAdded" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="ReleaseDate" class="form-label"></label>
                        <input asp-for="ReleaseDate" class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NextReleaseDate" class="form-label"></label>
                        <input asp-for="NextReleaseDate" class="form-control" />
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsFavorite" class="form-check-input" />
                            <label asp-for="IsFavorite" class="form-check-label"></label>
                        </div>
                    </div>

                    <div class="col-12 create-section-title">Affiches et notes</div>

                    <div class="col-md-6">
                        <label asp-for="PosterUrl" class="form-label"></label>
                        <input asp-for="PosterUrl" class="form-control" placeholder="https://..." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BackdropUrl" class="form-label"></label>
                        <input asp-for="BackdropUrl" class="form-control" placeholder="https://..." />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Ajouter une affiche depuis le PC</label>
                        <input type="file" name="posterFile" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                        <small class="text-muted">Si un fichier est choisi, il remplace l'URL affiche.</small>
                    </div>

                    <div class="col-12">
                        <label asp-for="PersonalComment" class="form-label"></label>
                        <textarea asp-for="PersonalComment" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="PersonalComment" class="text-danger"></span>
                    </div>

                    <div class="col-12 d-flex flex-wrap gap-2 pt-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check2-circle me-1"></i> Enregistrer
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </section>
    </div>

    <div class="col-xl-4">
        <aside class="card border-0 shadow-sm reveal premium-panel create-side-panel">
            <div class="card-body p-3 p-md-4">
                <h2 class="h5 mb-3">Qualite de fiche</h2>
                <div class="create-tip-list">
                    <div class="create-tip-item">
                        <span class="create-tip-dot"></span>
                        <p class="mb-0">Renseignez un titre court et un genre clair.</p>
                    </div>
                    <div class="create-tip-item">
                        <span class="create-tip-dot"></span>
                        <p class="mb-0">Ajoutez une affiche pour un rendu premium en grille.</p>
                    </div>
                    <div class="create-tip-item">
                        <span class="create-tip-dot"></span>
                        <p class="mb-0">Saisissez la progression pour activer le bouton Reprendre.</p>
                    </div>
                    <div class="create-tip-item">
                        <span class="create-tip-dot"></span>
                        <p class="mb-0">Definissez une date de sortie pour alimenter le calendrier.</p>
                    </div>
                </div>
                <hr class="my-3" />
                <div class="d-flex flex-wrap gap-2">
                    <span class="hero-tag">TMDB ready</span>
                    <span class="hero-tag">Watchlist</span>
                    <span class="hero-tag">Stats</span>
                    <span class="hero-tag">Mobile</span>
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

