@model Serie
@{
    ViewData["Title"] = "Supprimer un contenu";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0 text-danger">Supprimer un contenu</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour</a>
</div>

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <p class="mb-4">
            Vous allez supprimer <strong>@Model.Title</strong>. Cette action est irreversible.
        </p>

        <dl class="row mb-4">
            <dt class="col-sm-3">Genre</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9">
                @(Model.Status switch
                {
                    SerieStatus.Watchlist => "A voir",
                    SerieStatus.EnCours => "En cours",
                    SerieStatus.Termine => "Termine",
                    SerieStatus.Abandonne => "Abandonne",
                    _ => Model.Status.ToString()
                })
            </dd>

            <dt class="col-sm-3">Progression</dt>
            <dd class="col-sm-9">@Model.WatchedEpisodes / @Model.TotalEpisodes episode(s)</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">Confirmer la suppression</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>

