@model SeriesDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tableau de bord";
    var chartLabelsJson = JsonSerializer.Serialize(Model.ChartLabels);
    var chartValuesJson = JsonSerializer.Serialize(Model.ChartValues);
    var quickResumeId = Model.ResumeItems.Count > 0 ? Model.ResumeItems[0].Id : (int?)null;
    var remainingHours = (int)Math.Ceiling(Model.EstimatedRemainingMinutes / 60d);
}

<div class="d-none">@Html.AntiForgeryToken()</div>

<section class="hero-strip mb-4 p-4 rounded-4 reveal premium-panel ops-hero">
    <div class="row g-4 align-items-center">
        <div class="col-lg-8">
            <p class="ops-kicker mb-2">POSTE DE COMMANDE</p>
            <h1 class="h2 mb-2">Centre de pilotage visionnage</h1>
            <p class="ops-subtitle mb-3">Reprenez vite, priorisez votre watchlist et anticipez les prochaines sorties.</p>

            <div class="d-flex flex-wrap gap-2 mb-3 ops-actions">
                @if (quickResumeId.HasValue)
                {
                    <a asp-action="Details" asp-route-id="@quickResumeId.Value" class="btn btn-primary">
                        <i class="bi bi-play-circle me-1"></i> Reprendre
                    </a>
                }
                else
                {
                    <a asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i> Ajouter un contenu
                    </a>
                }

                <a asp-action="Calendar" class="btn btn-outline-secondary">
                    <i class="bi bi-calendar3 me-1"></i> Calendrier
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-grid me-1"></i> Bibliotheque
                </a>
            </div>

            <div class="ops-signal-row">
                <span class="ops-signal-chip"><i class="bi bi-lightning-charge-fill"></i> @Model.ResumeItems.Count reprise(s)</span>
                <span class="ops-signal-chip"><i class="bi bi-clock-history"></i> @remainingHours h restantes</span>
                <span class="ops-signal-chip"><i class="bi bi-heart-fill"></i> @Model.FavoriteItems favoris</span>
            </div>
        </div>

        <div class="col-lg-4">
            <aside class="ops-hero-aside premium-panel">
                <h2 class="h6 mb-3">Vue express</h2>
                <div class="ops-hero-metric">
                    <span>Moyenne des notes</span>
                    <strong>@Model.AverageRating.ToString("0.00") / 10</strong>
                </div>
                <div class="ops-hero-metric">
                    <span>En cours</span>
                    <strong>@Model.InProgressItems</strong>
                </div>
                <div class="ops-hero-metric">
                    <span>A voir</span>
                    <strong>@Model.WatchlistItems</strong>
                </div>
            </aside>
        </div>
    </div>
</section>

<div class="row g-3 mb-4 reveal">
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-collection-play"></i></span>
            <span>Total</span>
            <strong>@Model.TotalItems</strong>
        </article>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-bookmark-star"></i></span>
            <span>A voir</span>
            <strong>@Model.WatchlistItems</strong>
        </article>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-play-btn"></i></span>
            <span>En cours</span>
            <strong>@Model.InProgressItems</strong>
        </article>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-check2-circle"></i></span>
            <span>Termine</span>
            <strong>@Model.CompletedItems</strong>
        </article>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-heart"></i></span>
            <span>Favoris</span>
            <strong>@Model.FavoriteItems</strong>
        </article>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <article class="ops-stat-card">
            <span class="ops-stat-icon"><i class="bi bi-hourglass-split"></i></span>
            <span>Temps restant</span>
            <strong>@Model.EstimatedRemainingMinutes min</strong>
        </article>
    </div>
</div>

<div class="row g-4 mb-4 reveal premium-section">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100 premium-panel ops-panel">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">A regarder ensuite</h2>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Tout voir</a>
                </div>
                @if (!Model.WatchNext.Any())
                {
                    <p class="text-muted mb-0">Ajoutez des contenus dans "A voir" pour obtenir des suggestions.</p>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var item in Model.WatchNext)
                        {
                            <div class="col-sm-6">
                                <a asp-action="Details" asp-route-id="@item.Id" class="watch-next-item d-flex align-items-center gap-2 text-decoration-none">
                                    <div class="watch-next-thumb" style="background-image:url('@(item.PosterUrl ?? item.BackdropUrl)')"></div>
                                    <div>
                                        <div class="fw-semibold text-body">@item.Title</div>
                                        <small class="text-muted">@item.ContentType - @item.Status</small>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100 premium-panel ops-panel">
            <div class="card-body">
                <h2 class="h5 mb-3">Repartition des statuts</h2>
                <canvas id="statusChart" height="200"></canvas>
                <p class="text-muted small mb-0 mt-2">Moyenne des notes: <strong>@Model.AverageRating.ToString("0.00")/10</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4 reveal premium-section">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 premium-panel ops-panel">
            <div class="card-body">
                <h2 class="h5 mb-3">Continuer le visionnage</h2>
                @if (!Model.ResumeItems.Any())
                {
                    <p class="text-muted mb-0">Aucun contenu en pause pour l'instant.</p>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var item in Model.ResumeItems)
                        {
                            <div class="col-12">
                                <div class="watch-next-item d-flex justify-content-between align-items-center gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="watch-next-thumb" style="background-image:url('@(item.PosterUrl ?? item.BackdropUrl)')"></div>
                                        <div>
                                            <div class="fw-semibold">@item.Title</div>
                                            <small class="text-muted">@item.WatchedEpisodes/@item.TotalEpisodes episodes</small>
                                        </div>
                                    </div>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Reprendre</a>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100 premium-panel ops-panel">
            <div class="card-body">
                <h2 class="h5 mb-3">Sorties de la semaine</h2>
                @if (!Model.UpcomingThisWeek.Any())
                {
                    <p class="text-muted mb-0">Aucune sortie planifiee cette semaine.</p>
                }
                else
                {
                    <div class="ops-upcoming-list">
                        @foreach (var item in Model.UpcomingThisWeek)
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="ops-upcoming-item d-flex justify-content-between align-items-center">
                                <span>@item.Title</span>
                                <span class="badge text-bg-info ops-upcoming-date">@item.NextReleaseDate?.ToString("dd MMM")</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<section class="card border-0 shadow-sm reveal premium-panel ops-panel ops-watchlist-panel">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="h5 mb-0">Ma liste (glisser-deposer)</h2>
            <small id="watchlistStatus" class="text-muted">Glissez les cartes pour modifier l'ordre.</small>
        </div>
        @if (!Model.WatchlistQueue.Any())
        {
            <p class="text-muted mb-0">Aucun contenu dans la watchlist.</p>
        }
        else
        {
            <div id="watchlistSortable" class="watchlist-sortable">
                @foreach (var item in Model.WatchlistQueue)
                {
                    <article class="watchlist-sort-item" data-id="@item.Id" draggable="true">
                        <div class="watch-next-thumb" style="background-image:url('@(item.PosterUrl ?? item.BackdropUrl)')"></div>
                        <div class="watchlist-sort-body">
                            <strong>@item.Title</strong>
                            <small>@item.ContentType | @item.Genre</small>
                        </div>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Voir</a>
                    </article>
                }
            </div>
        }
    </div>
</section>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(chartLabelsJson);
        const values = @Html.Raw(chartValuesJson);
        const root = getComputedStyle(document.documentElement);
        const chartColor = root.getPropertyValue('--accent').trim() || '#1d4ed8';

        const ctx = document.getElementById('statusChart');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: [
                        chartColor,
                        '#0ea5e9',
                        '#10b981',
                        '#ef4444'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '68%'
            }
        });

        (() => {
            const container = document.getElementById('watchlistSortable');
            const status = document.getElementById('watchlistStatus');
            if (!container) return;

            let draggedItem = null;
            let saveTimeout = null;
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const csrf = tokenInput?.value;

            const updateStatus = (text, danger = false) => {
                if (!status) return;
                status.textContent = text;
                status.classList.toggle('text-danger', danger);
                status.classList.toggle('text-muted', !danger);
            };

            const scheduleSave = () => {
                clearTimeout(saveTimeout);
                saveTimeout = setTimeout(async () => {
                    const orderedIds = [...container.querySelectorAll('.watchlist-sort-item')].map(x => Number(x.dataset.id));
                    try {
                        const response = await fetch('/Series/ReorderWatchlist', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                ...(csrf ? { 'RequestVerificationToken': csrf } : {})
                            },
                            body: JSON.stringify({ orderedIds })
                        });

                        if (!response.ok) {
                            updateStatus('Impossible d\'enregistrer l\'ordre.', true);
                            return;
                        }

                        updateStatus('Ordre enregistre.');
                    } catch {
                        updateStatus('Erreur reseau lors de l\'enregistrement.', true);
                    }
                }, 200);
            };

            container.querySelectorAll('.watchlist-sort-item').forEach(item => {
                item.addEventListener('dragstart', () => {
                    draggedItem = item;
                    item.classList.add('dragging');
                });

                item.addEventListener('dragend', () => {
                    item.classList.remove('dragging');
                    draggedItem = null;
                    scheduleSave();
                });

                item.addEventListener('dragover', (event) => {
                    event.preventDefault();
                    if (!draggedItem || draggedItem === item) return;
                    const rect = item.getBoundingClientRect();
                    const isAfter = (event.clientY - rect.top) > rect.height / 2;
                    if (isAfter) {
                        item.after(draggedItem);
                    } else {
                        item.before(draggedItem);
                    }
                });
            });
        })();
    </script>
}
