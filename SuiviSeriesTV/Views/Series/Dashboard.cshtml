@model SeriesDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Tableau de bord";
    var chartLabelsJson = JsonSerializer.Serialize(Model.ChartLabels);
    var chartValuesJson = JsonSerializer.Serialize(Model.ChartValues);
}

<section class="hero-strip mb-4 p-4 rounded-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">Tableau de bord narratif</h1>
            <p class="text-muted mb-0">Suivez votre rythme, vos prochaines sorties et ce qu'il reste a reprendre.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Calendar" class="btn btn-outline-secondary">Calendrier</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Bibliotheque</a>
        </div>
    </div>
</section>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>Total</span><strong>@Model.TotalItems</strong></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>A voir</span><strong>@Model.WatchlistItems</strong></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>En cours</span><strong>@Model.InProgressItems</strong></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>Termine</span><strong>@Model.CompletedItems</strong></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>Favoris</span><strong>@Model.FavoriteItems</strong></div>
    </div>
    <div class="col-6 col-md-4 col-xl-2">
        <div class="mini-stat-card"><span>Temps restant</span><strong>@Model.EstimatedRemainingMinutes min</strong></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">A regarder ensuite</h2>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Tout voir</a>
                </div>
                @if (!Model.WatchNext.Any())
                {
                    <p class="text-muted mb-0">Ajoutez des contenus dans "A voir" pour obtenir des suggestions.</p>
                }
                else
                {
                    <div class="row g-2">
                        @foreach (var item in Model.WatchNext)
                        {
                            <div class="col-sm-6">
                                <a asp-action="Details" asp-route-id="@item.Id" class="watch-next-item d-flex align-items-center gap-2 text-decoration-none">
                                    <div class="watch-next-thumb" style="background-image:url('@(item.PosterUrl ?? item.BackdropUrl)')"></div>
                                    <div>
                                        <div class="fw-semibold text-body">@item.Title</div>
                                        <small class="text-muted">@item.ContentType - @item.Status</small>
                                    </div>
                                </a>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Repartition des statuts</h2>
                <canvas id="statusChart" height="200"></canvas>
                <p class="text-muted small mb-0 mt-2">Moyenne des notes: <strong>@Model.AverageRating.ToString("0.00")/10</strong></p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Reprendre la lecture</h2>
                @if (!Model.ResumeItems.Any())
                {
                    <p class="text-muted mb-0">Aucun contenu en pause pour l'instant.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.ResumeItems)
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@item.Title</span>
                                <span class="small text-muted">@item.WatchedEpisodes/@item.TotalEpisodes</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h2 class="h5 mb-3">Sorties de la semaine</h2>
                @if (!Model.UpcomingThisWeek.Any())
                {
                    <p class="text-muted mb-0">Aucune sortie planifiee cette semaine.</p>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model.UpcomingThisWeek)
                        {
                            <a asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <span>@item.Title</span>
                                <span class="badge text-bg-info">@item.NextReleaseDate?.ToString("dd MMM")</span>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(chartLabelsJson);
        const values = @Html.Raw(chartValuesJson);
        const root = getComputedStyle(document.documentElement);
        const chartColor = root.getPropertyValue('--accent').trim() || '#1d4ed8';

        const ctx = document.getElementById('statusChart');
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: [
                        chartColor,
                        '#0ea5e9',
                        '#10b981',
                        '#ef4444'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                plugins: {
                    legend: { position: 'bottom' }
                },
                cutout: '68%'
            }
        });
    </script>
}

