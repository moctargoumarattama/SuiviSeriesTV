@model IReadOnlyList<Serie>
@{
    ViewData["Title"] = "Calendrier des sorties";
    var groups = Model
        .Where(x => x.NextReleaseDate.HasValue)
        .GroupBy(x => x.NextReleaseDate!.Value.Date)
        .OrderBy(g => g.Key)
        .ToList();
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1 class="h3 mb-0">Calendrier des sorties</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Retour a la bibliotheque</a>
</div>

@if (!groups.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-5 text-center">
            <h2 class="h5">Aucune sortie planifiee</h2>
            <p class="text-muted mb-0">Ajoutez une date de sortie ou importez des contenus TMDB pour alimenter ce calendrier.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var day in groups)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">@day.Key.ToString("dddd dd MMMM yyyy")</h2>
                        <div class="list-group list-group-flush">
                            @foreach (var item in day.OrderBy(x => x.Title))
                            {
                                <a asp-action="Details" asp-route-id="@item.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span>@item.Title</span>
                                    <span class="badge text-bg-secondary">@item.ContentType</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

