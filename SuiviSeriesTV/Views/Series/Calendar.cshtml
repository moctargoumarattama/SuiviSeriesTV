@model IReadOnlyList<Serie>
@{
    ViewData["Title"] = "Calendrier des sorties";
    var groups = Model
        .Where(x => x.NextReleaseDate.HasValue)
        .GroupBy(x => x.NextReleaseDate!.Value.Date)
        .OrderBy(g => g.Key)
        .ToList();
}

<section class="hero-strip rounded-4 p-4 p-md-5 mb-4 reveal premium-panel calendar-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <p class="ops-kicker mb-2">UPCOMING TRACKER</p>
            <h1 class="h2 mb-2">Calendrier des sorties</h1>
            <p class="text-muted mb-0">Visualisez les prochains episodes et films a ne pas manquer.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary mt-1">
            <i class="bi bi-grid me-1"></i> Retour bibliotheque
        </a>
    </div>
</section>

@if (!groups.Any())
{
    <div class="card border-0 shadow-sm reveal premium-panel calendar-empty">
        <div class="card-body p-5 text-center">
            <h2 class="h5 mb-2">Aucune sortie planifiee</h2>
            <p class="text-muted mb-0">Ajoutez une date de sortie ou importez des contenus TMDB.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3 reveal premium-section">
        @foreach (var day in groups)
        {
            <div class="col-12">
                <section class="card border-0 shadow-sm premium-panel calendar-day-card">
                    <div class="card-body">
                        <header class="calendar-day-head">
                            <h2 class="h5 mb-0">@day.Key.ToString("dddd dd MMMM yyyy")</h2>
                            <span class="calendar-day-count">@day.Count() sortie(s)</span>
                        </header>

                        <div class="calendar-list">
                            @foreach (var item in day.OrderBy(x => x.Title))
                            {
                                var cover = !string.IsNullOrWhiteSpace(item.PosterUrl)
                                    ? item.PosterUrl
                                    : item.BackdropUrl;

                                <a asp-action="Details" asp-route-id="@item.Id" class="calendar-item">
                                    <div class="calendar-item-cover" style="background-image:url('@cover')"></div>
                                    <div class="calendar-item-body">
                                        <strong class="clamp-2">@item.Title</strong>
                                        <small>@item.ContentType | @item.Status</small>
                                    </div>
                                    <span class="badge admin-pill soft">@item.Genre</span>
                                </a>
                            }
                        </div>
                    </div>
                </section>
            </div>
        }
    </div>
}

