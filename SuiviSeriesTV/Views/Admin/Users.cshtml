@model IReadOnlyList<AdminUserItemViewModel>
@{
    ViewData["Title"] = "Gestion des utilisateurs";
    var search = ViewData["Search"] as string;
}

<section class="hero-strip rounded-4 p-4 p-md-5 mb-4 reveal premium-panel admin-hero">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <p class="ops-kicker mb-2">ADMIN USERS</p>
            <h1 class="h2 mb-2">Gestion des utilisateurs</h1>
            <p class="text-muted mb-0">Verrouillez, promouvez ou supprimez des comptes en toute securite.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary mt-1">
            <i class="bi bi-arrow-left me-1"></i> Retour dashboard admin
        </a>
    </div>
</section>

<section class="card border-0 shadow-sm mb-4 reveal premium-panel admin-search-panel">
    <div class="card-body">
        <form method="get" asp-action="Users" class="row g-3 align-items-end">
            <div class="col-lg-10">
                <label class="form-label" for="search">Rechercher par email ou nom utilisateur</label>
                <input id="search" name="search" class="form-control form-control-lg" value="@search" placeholder="ex: user@zerratv.local ou zerra_user" />
            </div>
            <div class="col-lg-2 d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Rechercher</button>
            </div>
        </form>
    </div>
</section>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm reveal premium-panel">
        <div class="card-body text-center p-5">
            <h2 class="h5 mb-2">Aucun utilisateur trouve</h2>
            <p class="text-muted mb-0">Essayez un autre email ou retirez le filtre de recherche.</p>
        </div>
    </div>
}
else
{
    <section class="card border-0 shadow-sm reveal premium-panel admin-users-panel">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 admin-users-table">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Nom utilisateur</th>
                            <th>Confirmation</th>
                            <th>Profil</th>
                            <th>Etat</th>
                            <th>Cree le</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="fw-semibold" data-label="Email">@user.Email</td>
                                <td data-label="Nom utilisateur">
                                    <form asp-action="RenameUser" method="post" class="d-flex gap-1 align-items-center">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        @Html.AntiForgeryToken()
                                        <input
                                            type="text"
                                            name="newUserName"
                                            value="@user.UserName"
                                            class="form-control form-control-sm"
                                            minlength="3"
                                            maxlength="32"
                                            required />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Renommer</button>
                                    </form>
                                </td>
                                <td data-label="Confirmation">
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge admin-pill ok"><i class="bi bi-check-circle-fill me-1"></i>Oui</span>
                                    }
                                    else
                                    {
                                        <span class="badge admin-pill warn"><i class="bi bi-exclamation-triangle-fill me-1"></i>Non</span>
                                    }
                                </td>
                                <td data-label="Profil">
                                    @if (user.IsAdmin)
                                    {
                                        <span class="badge admin-pill neutral"><i class="bi bi-person-badge-fill me-1"></i>Admin</span>
                                    }
                                    else
                                    {
                                        <span class="badge admin-pill soft"><i class="bi bi-person-fill me-1"></i>Utilisateur</span>
                                    }
                                </td>
                                <td data-label="Etat">
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge admin-pill danger"><i class="bi bi-lock-fill me-1"></i>Bloque</span>
                                    }
                                    else
                                    {
                                        <span class="badge admin-pill ok"><i class="bi bi-unlock-fill me-1"></i>Actif</span>
                                    }
                                </td>
                                <td class="text-muted" data-label="Cree le">@user.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="text-end" data-label="Actions">
                                    <div class="d-inline-flex flex-wrap gap-1 justify-content-end">
                                        <form asp-action="ToggleLock" method="post">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                                @(user.IsLocked ? "Debloquer" : "Bloquer")
                                            </button>
                                        </form>

                                        <form asp-action="ToggleAdminRole" method="post">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-primary">
                                                @(user.IsAdmin ? "Retirer admin" : "Promouvoir admin")
                                            </button>
                                        </form>

                                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Confirmer la suppression de ce compte ?');">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
}
