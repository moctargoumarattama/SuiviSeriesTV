@using SuiviSeriesTV.Constants
<!DOCTYPE html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zerra TV</title>
    <link rel="icon" type="image/svg+xml" href="~/images/zerra-logo-v2.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <div id="splashScreen" class="splash-screen" aria-hidden="true">
        <div class="splash-content">
            <img src="~/images/zerra-logo-v2.svg" alt="" class="splash-logo" />
            <p class="splash-title">Zerra TV</p>
            <div class="splash-bar"><span></span></div>
        </div>
    </div>
    <div id="pageTransitionVeil" class="page-transition-veil" aria-hidden="true"></div>
    <div class="ambient-layer ambient-layer-one" aria-hidden="true"></div>
    <div class="ambient-layer ambient-layer-two" aria-hidden="true"></div>
    <div class="ambient-grid" aria-hidden="true"></div>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container">
                <a class="navbar-brand brand-logo-link" asp-controller="Home" asp-action="Index" aria-label="Accueil Zerra TV">
                    <img src="~/images/zerra-logo-v2.svg" alt="Logo Zerra TV" class="brand-logo-img" />
                    <span class="brand-logo-text">Zerra TV</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Accueil</a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Series" asp-action="Dashboard">Tableau de bord</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Series" asp-action="Index">Bibliotheque</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Index">Profil</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Series" asp-action="Calendar">Sorties</a>
                            </li>

                            @if (User.IsInRole(AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Admin" asp-action="Users">Administration</a>
                                </li>
                            }

                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm px-3 mt-2 mt-lg-0" asp-controller="Series" asp-action="Create">Ajouter</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 ms-lg-3 mt-3 mt-lg-0">
                        <button id="themeToggle" type="button" class="btn btn-sm btn-outline-secondary theme-toggle-btn" aria-label="Basculer le theme">
                            <span id="themeToggleText">Sombre</span>
                        </button>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary">Deconnexion</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Login">Connexion</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Inscription</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 main-shell">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer border-top py-3 text-muted">
        <div class="container d-flex justify-content-between flex-wrap gap-2">
            <span>&copy; @DateTime.Now.Year - Zerra TV</span>
            <span>Series | Films | Anime | Suivi premium</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const splash = document.getElementById('splashScreen');
            const veil = document.getElementById('pageTransitionVeil');
            const root = document.documentElement;
            const toggle = document.getElementById('themeToggle');
            const text = document.getElementById('themeToggleText');
            const stored = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const initial = stored || (prefersDark ? 'dark' : 'light');

            const applyTheme = (theme) => {
                root.setAttribute('data-theme', theme);
                text.textContent = theme === 'dark' ? 'Clair' : 'Sombre';
            };
            const resetTransitionState = () => {
                document.body.classList.remove('page-transitioning');
                veil?.classList.remove('is-active');
            };

            applyTheme(initial);
            resetTransitionState();

            toggle?.addEventListener('click', () => {
                const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                localStorage.setItem('theme', next);
                applyTheme(next);
            });

            window.addEventListener('pageshow', () => {
                resetTransitionState();
            });
            window.addEventListener('popstate', () => {
                resetTransitionState();
            });
            document.addEventListener('visibilitychange', () => {
                if (document.visibilityState === 'visible') {
                    resetTransitionState();
                }
            });

            const currentPath = window.location.pathname.toLowerCase();
            document.querySelectorAll('.nav-link').forEach(link => {
                const href = (link.getAttribute('href') || '').toLowerCase();
                if (href && href !== '/' && currentPath.startsWith(href)) {
                    link.classList.add('is-active');
                } else if (href === '/' && currentPath === '/') {
                    link.classList.add('is-active');
                }
            });

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            const saveData = navigator.connection && navigator.connection.saveData === true;
            const performanceMode = reduceMotion || saveData;

            if (!performanceMode) {
                const items = document.querySelectorAll('.reveal');
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('reveal-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.12 });

                items.forEach(item => observer.observe(item));
            } else {
                document.querySelectorAll('.reveal').forEach(item => item.classList.add('reveal-visible'));
            }

            const hideSplash = () => {
                splash?.classList.add('is-hidden');
                document.body.classList.add('page-ready');
            };

            const splashAlreadyShown = sessionStorage.getItem('zerraSplashShown') === '1';
            if (splashAlreadyShown || performanceMode) {
                hideSplash();
            } else {
                if (document.readyState === 'complete') {
                    setTimeout(hideSplash, 120);
                } else {
                    window.addEventListener('load', () => setTimeout(hideSplash, 120), { once: true });
                }
                sessionStorage.setItem('zerraSplashShown', '1');
            }

            const shouldAnimateLink = (anchor, event) => {
                if (!anchor) return false;
                if (event.defaultPrevented) return false;
                if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return false;
                if (anchor.target && anchor.target.toLowerCase() === '_blank') return false;
                if (anchor.hasAttribute('download') || anchor.dataset.noTransition !== undefined) return false;

                const href = anchor.getAttribute('href');
                if (!href || href.startsWith('#') || href.startsWith('javascript:')) return false;

                const url = new URL(anchor.href, window.location.origin);
                if (url.origin !== window.location.origin) return false;
                if (url.pathname === window.location.pathname && url.search === window.location.search) return false;

                return true;
            };

            document.addEventListener('click', (event) => {
                if (performanceMode) return;

                const anchor = event.target.closest('a');
                if (!shouldAnimateLink(anchor, event)) return;

                event.preventDefault();
                document.body.classList.add('page-transitioning');
                veil?.classList.add('is-active');

                // Safety net: if navigation is interrupted, restore the page state.
                window.setTimeout(() => {
                    resetTransitionState();
                }, 1200);

                setTimeout(() => {
                    window.location.assign(anchor.href);
                }, 90);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

