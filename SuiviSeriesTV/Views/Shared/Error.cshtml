@model ErrorViewModel
@{
    ViewData["Title"] = "Erreur";
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <h1 class="h3 text-danger">Une erreur est survenue.</h1>
        <p class="mb-0 text-muted">
            Une erreur inattendue s'est produite pendant le traitement de votre demande.
        </p>

        @if (Model.ShowRequestId)
        {
            <p class="mt-3 mb-0">
                <strong>Identifiant de requete :</strong> <code>@Model.RequestId</code>
            </p>
        }
    </div>
</div>

